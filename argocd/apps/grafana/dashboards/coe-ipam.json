    {
      "id": 10,
      "type": "table",
      "title": "Fastest-filling region blocks (change over 7 days)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(5, delta(coe_prefix_utilization_ratio{role=\"region-block\",tenant=~\"$tenant\",env=~\"$env\"}[7d]) > 0)",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "status": true,
              "role": true,
              "project": true
            },
            "renameByName": {
              "Value": "growth (7d)"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "growth (7d)",
            "desc": true
          }
        ]
      }
