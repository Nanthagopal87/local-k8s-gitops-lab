      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(coe_prefix_utilization_ratio{role=\"region-block\",tenant=~\"$tenant\",env=~\"$env\"} > 0.8) or vector(0)"
